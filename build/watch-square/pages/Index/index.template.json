{
  "type": "div",
  "bind": 1,
  "class": "page",
  "events": {
    "touchend": "te",
    "touchmove": "tm",
    "touchstart": "ts"
  },
  "style": {
    "width": "466px",
    "height": "466px",
    "flexDirection": "column",
    "backgroundColor": "#04060c",
    "paddingTop": "6px",
    "paddingRight": "10px",
    "paddingBottom": "6px",
    "paddingLeft": "10px",
    "alignItems": "center"
  },
  "styleObjectId": 1740532647,
  "children": [
    {
      "type": "div",
      "class": "hud",
      "style": {
        "flexDirection": "row",
        "alignItems": "center",
        "justifyContent": "space-between",
        "width": "340px",
        "height": "44px",
        "marginBottom": "4px"
      },
      "children": [
        {
          "type": "div",
          "class": "brand",
          "style": {
            "flexDirection": "column"
          },
          "children": [
            {
              "type": "text",
              "attr": {
                "value": "2048"
              },
              "class": "logo",
              "style": {
                "color": "#50dcff",
                "fontSize": "24px",
                "fontWeight": "bold",
                "letterSpacing": "2px"
              }
            }
          ]
        },
        {
          "type": "div",
          "class": "chips",
          "style": {
            "flexDirection": "row"
          },
          "children": [
            {
              "type": "div",
              "class": "chip",
              "style": {
                "width": "74px",
                "height": "44px",
                "flexDirection": "column",
                "alignItems": "center",
                "justifyContent": "center",
                "backgroundColor": "#0a1626",
                "borderTopWidth": "2px",
                "borderRightWidth": "2px",
                "borderBottomWidth": "2px",
                "borderLeftWidth": "2px",
                "borderStyle": "solid",
                "borderTopColor": "#1e3a52",
                "borderRightColor": "#1e3a52",
                "borderBottomColor": "#0c1c2e",
                "borderLeftColor": "#1e3a52",
                "borderRadius": "8px",
                "marginLeft": "6px"
              },
              "children": [
                {
                  "type": "text",
                  "attr": {
                    "$value": "score"
                  },
                  "bind": 1,
                  "class": "chipNum",
                  "style": {
                    "color": "#eaf6ff",
                    "fontSize": "16px",
                    "fontWeight": "bold"
                  }
                },
                {
                  "type": "text",
                  "attr": {
                    "value": "分数"
                  },
                  "class": "chipLbl",
                  "style": {
                    "color": "#5a7fa0",
                    "fontSize": "10px",
                    "marginTop": "1px"
                  }
                }
              ]
            },
            {
              "type": "div",
              "bind": 1,
              "class": "chip chipBest",
              "events": {
                "click": "openBoard"
              },
              "style": {
                "width": "74px",
                "height": "44px",
                "flexDirection": "column",
                "alignItems": "center",
                "justifyContent": "center",
                "backgroundColor": "#0a1626",
                "borderTopWidth": "2px",
                "borderRightWidth": "2px",
                "borderBottomWidth": "2px",
                "borderLeftWidth": "2px",
                "borderStyle": "solid",
                "borderTopColor": "#2a5a48",
                "borderRightColor": "#2a5a48",
                "borderBottomColor": "#2a5a48",
                "borderLeftColor": "#2a5a48",
                "borderRadius": "8px",
                "marginLeft": "6px"
              },
              "children": [
                {
                  "type": "text",
                  "attr": {
                    "$value": "best"
                  },
                  "bind": 1,
                  "class": "chipNum",
                  "style": {
                    "color": "#eaf6ff",
                    "fontSize": "16px",
                    "fontWeight": "bold"
                  }
                },
                {
                  "type": "text",
                  "attr": {
                    "value": "最高/榜"
                  },
                  "class": "chipLbl",
                  "style": {
                    "color": "#5a7fa0",
                    "fontSize": "10px",
                    "marginTop": "1px"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "canvas",
      "attr": {
        "id": "cv"
      },
      "bind": 1,
      "class": "cv",
      "style": {
        "width": "340px",
        "height": "340px"
      }
    },
    {
      "type": "div",
      "class": "foot",
      "style": {
        "flexDirection": "row",
        "alignItems": "center",
        "justifyContent": "space-between",
        "width": "340px",
        "marginTop": "6px"
      },
      "children": [
        {
          "type": "text",
          "attr": {
            "value": "v2.6"
          },
          "class": "ver",
          "style": {
            "color": "#233a4e",
            "fontSize": "11px"
          }
        },
        {
          "type": "text",
          "attr": {
            "value": "星域合成 · 滑动合成"
          },
          "class": "hint",
          "style": {
            "color": "#46648a",
            "fontSize": "12px"
          }
        },
        {
          "type": "text",
          "attr": {
            "value": "重开"
          },
          "bind": 1,
          "class": "btn",
          "events": {
            "click": "restart"
          },
          "style": {
            "width": "120px",
            "textAlign": "center",
            "color": "#04060c",
            "backgroundColor": "#50dcff",
            "fontSize": "18px",
            "fontWeight": "bold",
            "paddingTop": "6px",
            "paddingRight": "0px",
            "paddingBottom": "6px",
            "paddingLeft": "0px",
            "borderRadius": "8px",
            "borderBottomWidth": "3px",
            "borderBottomStyle": "solid",
            "borderBottomColor": "#1a6a86"
          }
        }
      ]
    },
    {
      "type": "stack",
      "$shown": "over",
      "bind": 2,
      "class": "ovlWrap",
      "shown": false,
      "children": [
        {
          "type": "div",
          "class": "ovlDim"
        },
        {
          "type": "div",
          "class": "ovlBox",
          "children": [
            {
              "type": "text",
              "attr": {
                "value": "战 报"
              },
              "class": "ovlTitle"
            },
            {
              "type": "text",
              "attr": {
                "$value": "function () { return '' + this.score + ' 分'; }"
              },
              "bind": 1,
              "class": "ovlScore"
            },
            {
              "type": "text",
              "$shown": "newRecord",
              "attr": {
                "value": "⚡ 新纪录！"
              },
              "bind": 2,
              "class": "ovlNote",
              "shown": false
            },
            {
              "type": "text",
              "$shown": "function () { return !this.newRecord; }",
              "attr": {
                "$value": "function () { return '' + '最高 ' + this.best + ' 分'; }"
              },
              "bind": 2,
              "class": "ovlNote",
              "shown": true
            },
            {
              "type": "text",
              "attr": {
                "value": "再来一局"
              },
              "bind": 1,
              "class": "ovlBtn",
              "events": {
                "click": "restart"
              }
            },
            {
              "type": "text",
              "attr": {
                "value": "积分榜"
              },
              "bind": 1,
              "class": "ovlBtn ghost",
              "events": {
                "click": "openBoard"
              }
            }
          ]
        }
      ]
    },
    {
      "type": "stack",
      "$shown": "showBoard",
      "bind": 2,
      "class": "ovlWrap",
      "shown": false,
      "children": [
        {
          "type": "div",
          "class": "ovlDim"
        },
        {
          "type": "div",
          "class": "ovlBox",
          "children": [
            {
              "type": "text",
              "attr": {
                "value": "积 分 榜"
              },
              "class": "ovlTitle"
            },
            {
              "type": "div",
              "bind": 2,
              "class": "bdRow",
              "repeat": {
                "$exp": "board",
                "key": "i",
                "value": "rec"
              },
              "children": [
                {
                  "type": "text",
                  "attr": {
                    "$value": "function () { return this.i + 1; }"
                  },
                  "bind": 1,
                  "class": "bdRank"
                },
                {
                  "type": "text",
                  "attr": {
                    "$value": "function () { return '' + this.rec.s + ' 分'; }"
                  },
                  "bind": 1,
                  "class": "bdScore"
                },
                {
                  "type": "text",
                  "attr": {
                    "$value": "rec.d"
                  },
                  "bind": 1,
                  "class": "bdDate"
                }
              ]
            },
            {
              "type": "text",
              "$shown": "function () { return this.board.length === 0; }",
              "attr": {
                "value": "暂无记录，去打第一局"
              },
              "bind": 2,
              "class": "bdEmpty",
              "shown": true
            },
            {
              "type": "text",
              "attr": {
                "value": "返 回"
              },
              "bind": 1,
              "class": "ovlBtn",
              "events": {
                "click": "closeBoard"
              }
            }
          ]
        }
      ]
    }
  ]
}